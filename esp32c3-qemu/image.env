# What tools/build.sh builds and how it smoke-tests it.
VERSION=1.0.0
UPSTREAM_TAG=64aed503e34a
PLATFORMS=linux/amd64,linux/arm64
DESCRIPTION="ESP32-C3 simulator: lcgamboa/qemu's esp32c3-picsimlab machine behind heypcb-c3-sidecar's GPIO/UART/I2C line protocol."
LICENSES="GPL-2.0-only AND GPL-2.0-or-later"
SMOKE_DIR=/opt/heypcb-c3
SMOKE_EXE=heypcb-c3-sidecar
SMOKE_LIB=libqemu-riscv32.so
SMOKE_FLASH=firmware/esp32c3-fw-probe.flash.bin.gz
SMOKE_MCU=esp32c3
SMOKE_LED=8
SMOKE_BUTTON=9
