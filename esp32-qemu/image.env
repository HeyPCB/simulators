# What tools/build.sh builds and how it smoke-tests it.
VERSION=1.0.0
UPSTREAM_TAG=64aed503e34a
PLATFORMS=linux/amd64,linux/arm64
DESCRIPTION="ESP32 (classic) simulator: lcgamboa/qemu's esp32-picsimlab machine behind heypcb-esp32-sidecar's GPIO/UART/I2C line protocol."
LICENSES="GPL-2.0-only AND GPL-2.0-or-later"
SMOKE_DIR=/opt/heypcb-esp32
SMOKE_EXE=heypcb-esp32-sidecar
SMOKE_LIB=libqemu-xtensa.so
SMOKE_FLASH=firmware/esp32-fw-probe.flash.bin.gz
SMOKE_MCU=esp32
SMOKE_LED=2
SMOKE_BUTTON=0
