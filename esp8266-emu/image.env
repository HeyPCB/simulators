# What tools/build.sh builds and how it smoke-tests it.
VERSION=1.0.0
UPSTREAM_TAG=c4c840d59b60
PLATFORMS=linux/amd64,linux/arm64
DESCRIPTION="ESP8266 (Xtensa LX106) simulator: digitake/esp8266-emulator's esp8266emu, its pins and serial as timed JSON lines."
LICENSES="MIT"
# Not a sidecar: the image runs esp8266emu itself, inputs from a timed script
# (tools/emu_smoke.py).
SMOKE_KIND=emu
SMOKE_DIR=/opt/heypcb-esp8266
SMOKE_EXE=esp8266emu
SMOKE_FLASH=firmware/esp8266-fw-probe.flash.bin.gz
SMOKE_MCU=esp8266
SMOKE_LED=2
SMOKE_BUTTON=0
